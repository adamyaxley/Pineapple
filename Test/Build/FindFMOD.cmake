cmake_minimum_required(VERSION 3.1)

set(_cases windows-x86 windows-x64 windows-legacy ios-device ios-simulator-arm64
	ios-simulator-x64 linux explicit legacy-override missing)

if(NOT DEFINED TEST_CASE)
	foreach(_case IN LISTS _cases)
		execute_process(
			COMMAND "${CMAKE_COMMAND}" "-DTEST_CASE=${_case}" -P "${CMAKE_CURRENT_LIST_FILE}"
			RESULT_VARIABLE _result)
		if(NOT _result EQUAL 0)
			message(FATAL_ERROR "FMOD discovery test failed: ${_case}")
		endif()
	endforeach()
	message(STATUS "All FMOD discovery tests passed")
	return()
endif()

list(FIND _cases "${TEST_CASE}" _case_index)
if(_case_index EQUAL -1)
	message(FATAL_ERROR "Unknown test case: ${TEST_CASE}")
endif()

set(FMOD_SDK "${CMAKE_CURRENT_BINARY_DIR}/fmod-finder-tests/${TEST_CASE}")
file(MAKE_DIRECTORY "${FMOD_SDK}/api/core/inc")
file(WRITE "${FMOD_SDK}/api/core/inc/fmod.hpp" "// Test fixture\n")
set(WIN32 FALSE)
set(IOS FALSE)
set(CMAKE_FIND_LIBRARY_PREFIXES lib)
set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
set(_library "api/core/lib/libfmod_iphoneos.a")

if(TEST_CASE MATCHES "^windows")
	set(WIN32 TRUE)
	set(CMAKE_FIND_LIBRARY_PREFIXES "")
	set(CMAKE_FIND_LIBRARY_SUFFIXES .lib)
	set(CMAKE_SIZEOF_VOID_P 8)
	set(_library "api/core/lib/x64/fmod_vc.lib")
	if(TEST_CASE STREQUAL "windows-x86")
		set(CMAKE_SIZEOF_VOID_P 4)
		set(_library "api/core/lib/x86/fmod_vc.lib")
	elseif(TEST_CASE STREQUAL "windows-legacy")
		set(_library "api/lowlevel/lib/fmod64_vc.lib")
	endif()
	file(MAKE_DIRECTORY "${FMOD_SDK}/api/core/lib/x86")
	file(WRITE "${FMOD_SDK}/api/core/lib/x86/fmod_vc.lib" "32-bit fixture")
elseif(TEST_CASE MATCHES "^ios")
	set(IOS TRUE)
	set(CMAKE_OSX_ARCHITECTURES arm64)
	set(CMAKE_OSX_SYSROOT iphoneos)
	if(TEST_CASE MATCHES "^ios-simulator")
		set(CMAKE_OSX_SYSROOT "/SDKs/iPhoneSimulator.sdk")
		set(_library "api/core/lib/libfmod_iphonesimulator.a")
	endif()
	if(TEST_CASE STREQUAL "ios-simulator-x64")
		set(CMAKE_OSX_ARCHITECTURES x86_64)
	endif()
elseif(TEST_CASE STREQUAL "linux")
	set(CMAKE_SYSTEM_PROCESSOR x86_64)
	set(_library "api/core/lib/x86_64/libfmod.a")
elseif(TEST_CASE STREQUAL "explicit" OR TEST_CASE STREQUAL "legacy-override")
	set(_library "custom/libcustom.a")
	set(FMOD_INCLUDE_DIRS "${FMOD_SDK}/api/core/inc" CACHE PATH "")
	if(TEST_CASE STREQUAL "explicit")
		set(FMOD_LIBRARIES "${FMOD_SDK}/${_library}" CACHE FILEPATH "")
	else()
		set(FMOD_LIBRARY "${FMOD_SDK}/${_library}")
	endif()
endif()

get_filename_component(_directory "${FMOD_SDK}/${_library}" DIRECTORY)
file(MAKE_DIRECTORY "${_directory}")
if(NOT TEST_CASE STREQUAL "missing")
	file(WRITE "${FMOD_SDK}/${_library}" "Library fixture")
	set(FMOD_FIND_REQUIRED TRUE)
else()
	set(CMAKE_FIND_ROOT_PATH "${FMOD_SDK}/empty")
	set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH FALSE)
	set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH FALSE)
	set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH FALSE)
	set(FMOD_FIND_QUIETLY TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../Build/CMake/FindFMOD.cmake")

if(TEST_CASE STREQUAL "missing")
	if(FMOD_FOUND)
		message(FATAL_ERROR "Missing SDK library incorrectly reported as found")
	endif()
elseif(NOT FMOD_LIBRARIES STREQUAL "${FMOD_SDK}/${_library}")
	message(FATAL_ERROR "Wrong library: ${FMOD_LIBRARIES}; expected ${FMOD_SDK}/${_library}")
elseif(NOT FMOD_INCLUDE_DIRS STREQUAL "${FMOD_SDK}/api/core/inc")
	message(FATAL_ERROR "Wrong include directory: ${FMOD_INCLUDE_DIRS}")
endif()
message(STATUS "Passed: ${TEST_CASE}")
